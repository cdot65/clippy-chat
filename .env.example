DATABASE_URL=postgres://clippy:clippy@localhost:5433/clippy
APP_URL=http://localhost:3000
# In-cluster AIRS gateway; external callers use https://airs.cdot.io
INFERENCE_BASE_URL=http://airs-gw.airs-gw.svc.cluster.local:80
INFERENCE_MODEL=@vllm2/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
INFERENCE_API_KEY= # gateway key (gateway mode) or vLLM --api-key (direct mode)
INFERENCE_AUTH_MODE=direct # gateway ⇒ x-portkey-api-key; direct ⇒ Authorization: Bearer
# Gateway inference identity (scope completions.write). Set these instead of
# INFERENCE_API_KEY in gateway mode; separate Keycloak client from MCP.
INFERENCE_TOKEN_URL=https://auth.example.com/realms/myrealm/protocol/openid-connect/token
INFERENCE_CLIENT_ID=clippy-inference-client
INFERENCE_CLIENT_SECRET=changeme
KC_ISSUER=https://auth.example.com/realms/myrealm
KC_CLIENT_ID=clippy-web
KC_CLIENT_SECRET=changeme
SESSION_SECRET=<openssl rand -base64 32>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
M2M_SCOPE=clippy-api
# Expected aud on machine bearer tokens. Leave unset until the Keycloak client's
# dedicated scope mints this audience — arming it early 401s every machine caller.
# M2M_AUDIENCE=clippy-api
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_AUTH_MODE=direct # gateway ⇒ x-portkey-api-key + X-Auth-Token (AIRS route)
MCP_TOKEN_URL=https://auth.example.com/realms/myrealm/protocol/openid-connect/token
MCP_CLIENT_ID=clippy-mcp-client
MCP_CLIENT_SECRET=changeme
BRAVE_API_KEY=
SCM_CLIENT_ID=
SCM_CLIENT_SECRET=
SCM_TSG_ID=
